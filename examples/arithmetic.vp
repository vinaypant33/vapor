# Arithmetic in Vapor
let_it a = 17
let_it b = 5

print("a + b =", a + b)
print("a - b =", a - b)
print("a * b =", a * b)
print("a / b =", a / b)
print("a % b =", a % b)

# * and / happen before + and -
print("2 + 3 * 4 =", 2 + 3 * 4)
print("(2 + 3) * 4 =", (2 + 3) * 4)

# Negative numbers
print("-a + b =", -a + b)
